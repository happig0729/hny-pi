# 后端 API 地址（开发时 Vite proxy 目标）
VITE_DEV_SERVER_PORT=5183
VITE_API_PROXY_TARGET=http://localhost:8080

# API 基础路径
VITE_API_BASE_URL=/api/v1

# 自动登录（若后端需要，真实凭据放 .env.local）
VITE_AUTH_ENABLED=true
VITE_AUTH_USERNAME=
VITE_AUTH_PASSWORD=

# LLM API Key（可选，也可在 UI 中手动设置）
VITE_DEEPSEEK_API_KEY=

# Tavily Web Search API Key（可选）
VITE_TAVILY_API_KEY=
